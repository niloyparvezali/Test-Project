rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function validDate(v) { return v is string && v.matches('^\\d{4}-\\d{2}-\\d{2}$'); }
    function validMethod(v) { return v in ['Cash','Mobile Banking','Bank Transfer','Other']; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /turf/{id} { allow read: if true; allow write: if isAdmin(); }
    match /pricing/{id} { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{id} { allow read: if true; allow write: if isAdmin(); }

    // Public availability contains only slot metadata; no customer information.
    match /slotLocks/{id} {
      allow read: if true;
      allow create: if !signedIn()
        && request.resource.data.status == 'booked'
        && request.resource.data.bookingId is string
        && request.resource.data.sessionDate is string
        && request.resource.data.slotStart is string
        && request.resource.data.slotKey == id
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.slotKey == id;
      allow update, delete: if isAdmin();
    }

    // A public visitor may create a booking. The lock must be created atomically
    // with it, preventing two clients from claiming the same slot.
    match /bookings/{id} {
      allow read: if isAdmin();
      allow create: if !signedIn()
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 5
        && validDate(request.resource.data.sessionDate)
        && request.resource.data.status == 'confirmed'
        && request.resource.data.slotKey is string
        && request.resource.data.duration in [60,90]
        && request.resource.data.shift in ['day','night']
        && request.resource.data.totalAmount is number
        && request.resource.data.slotPrice is number
        && request.resource.data.totalAmount == request.resource.data.slotPrice
        && request.resource.data.paidAmount is number
        && request.resource.data.advanceAmount is number
        && request.resource.data.remainingAmount is number
        && request.resource.data.dueAmount is number
        && request.resource.data.paidAmount == request.resource.data.advanceAmount
        && request.resource.data.remainingAmount == request.resource.data.totalAmount - request.resource.data.advanceAmount
        && request.resource.data.dueAmount == request.resource.data.remainingAmount
        && request.resource.data.advanceAmount >= 0
        && request.resource.data.advanceAmount <= request.resource.data.totalAmount
        && request.resource.data.createdBy == 'public'
        && ((request.resource.data.duration == 60 && request.resource.data.shift == 'day' && request.resource.data.totalAmount == get(/databases/$(database)/documents/pricing/current).data.rules['60'].day)
          || (request.resource.data.duration == 60 && request.resource.data.shift == 'night' && request.resource.data.totalAmount == get(/databases/$(database)/documents/pricing/current).data.rules['60'].night)
          || (request.resource.data.duration == 90 && request.resource.data.shift == 'day' && request.resource.data.totalAmount == get(/databases/$(database)/documents/pricing/current).data.rules['90'].day)
          || (request.resource.data.duration == 90 && request.resource.data.shift == 'night' && request.resource.data.totalAmount == get(/databases/$(database)/documents/pricing/current).data.rules['90'].night))
        && getAfter(/databases/$(database)/documents/slotLocks/$(request.resource.data.slotKey)).data.bookingId == id;
      allow update, delete: if isAdmin();
    }

    // Public booking advances are written in the same transaction as the booking.
    match /payments/{id} {
      allow read: if isAdmin();
      allow create: if !signedIn()
        && request.resource.data.bookingId is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && validMethod(request.resource.data.paymentMethod)
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.advanceAmount == request.resource.data.amount
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.createdBy == 'public'
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.createdAt == request.resource.data.createdAt;
      allow update, delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if isAdmin();
      allow create: if !signedIn()
        && request.resource.data.type == 'income'
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.referenceId is string
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.referenceId)).data.advanceAmount == request.resource.data.amount
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.referenceId)).data.createdBy == 'public'
        && getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.referenceId)).data.createdAt == request.resource.data.createdAt;
      allow update, delete: if isAdmin();
    }

    match /expenses/{id} { allow read: if isAdmin(); allow write: if isAdmin(); }

    match /{document=**} { allow read, write: if false; }
  }
}
